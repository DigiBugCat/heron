{
	"name": "heron",
	"version": "0.1.0",
	"description": "Read and navigate any local codebase with language-server navigation, git history and diffs, without leaving your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:vault": "node scripts/link-test-vault.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/language": "^6.12.3",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/lsp-client": "^6.3.0",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@eslint/js": "^9.39.4",
		"@lezer/highlight": "^1.2.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.15.17",
		"basedpyright": "^1.40.2",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^26.1.0",
		"obsidian": "^1.12.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"typescript-language-server": "^4.4.1",
		"vitest": "^3.2.7"
	}
}
